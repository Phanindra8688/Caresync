{
	"name": "Source_to_sliver_inner",
	"properties": {
		"activities": [
			{
				"name": "Getting_table_config",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "select * from ctrl.table_config where table_id = '@{pipeline().parameters.table_id}'",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_AzureSqlTable",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "Start_Time",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "start_Time",
					"value": {
						"value": "@formatDateTime(utcNow(),'yyyy-MM-dd_hh:mm:ss')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "source to silver",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Getting_table_config",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Start_Time",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "PostgreSqlV2Source",
						"query": {
							"value": "select * from PUBLIC.@{activity('Getting_table_config').output.firstRow.source_table_name};",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00"
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "PostgreSqlTable1",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "Parquet1",
						"type": "DatasetReference",
						"parameters": {
							"container": "landing",
							"folder": {
								"value": "@concat(\n    activity('Getting_table_config').output.firstRow.source_system,\n    '/',\n    activity('Getting_table_config').output.firstRow.source_table_name,\n    '/',\n    variables('start_Time')\n)",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "landing-to-bronze",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "source to silver",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/caresync-repo/caresync-azure-databricks/landing_to_bronz",
					"baseParameters": {
						"source system": {
							"value": "@activity('Getting_table_config').output.firstRow.source_system",
							"type": "Expression"
						},
						"table name": {
							"value": "@activity('Getting_table_config').output.firstRow.bronze_table_name",
							"type": "Expression"
						},
						"landing timestamp": {
							"value": "@variables('start_Time')",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "adb_access_token_AzureDatabricks",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "bronze_to_silver",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "landing-to-bronze",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/caresync-repo/caresync-azure-databricks/bronz_to_silver",
					"baseParameters": {
						"table_name": {
							"value": "@activity('Getting_table_config').output.firstRow.silver_table_name",
							"type": "Expression"
						},
						"landing_timestamp": {
							"value": "@variables('start_Time')",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "adb_access_token_AzureDatabricks",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Completed Log",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "bronze_to_silver",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "LS_AzureSqlDatabase",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "update ctrl.audit_log set status='Success', end_time=SYSUTCDATETIME(), records_written=@{activity('bronze_to_silver').output.runOutput} WHERE adf_run_id = '@{pipeline().parameters.adf_run_id}' AND\ntable_id = pipeline().parameters.table_id",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			}
		],
		"parameters": {
			"adf_run_id": {
				"type": "String",
				"defaultValue": "a3"
			},
			"table_id": {
				"type": "string",
				"defaultValue": "1"
			}
		},
		"variables": {
			"start_Time": {
				"type": "String"
			}
		},
		"annotations": []
	}
}